// Personal Finance Tracker — схема даних
// Гроші скрізь зберігаються в мінорних одиницях (копійки/центи) як Int.
// SQLite не підтримує enum у Prisma — рядкові поля, значення в src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  id               String    @id @default("singleton")
  baseCurrency     String    @default("UAH")
  monobankToken    String? // AES-256-GCM ciphertext
  monobankTokenHint String? // останні 4 символи для UI
  apiKey           String? // ciphertext, для iOS Shortcuts
  defaultAccountId String?
  lastSyncAt       DateTime?
  lastSyncStatus   String? // OK | ERROR
  lastSyncError    String?
  updatedAt        DateTime  @updatedAt
}

model Account {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("CARD") // CASH | CARD | SAVINGS | JAR | OTHER
  currency      String   @default("UAH")
  balance       Int      @default(0)
  color         String   @default("#3f6f5c")
  isArchived    Boolean  @default(false)
  sortOrder     Int      @default(0)

  monoAccountId String?  @unique
  monoMaskedPan String?
  monoType      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions     Transaction[] @relation("TxAccount")
  incomingTransfers Transaction[] @relation("TxToAccount")
  recurring        RecurringPayment[]

  @@index([isArchived, sortOrder])
}

model Category {
  id        String  @id @default(cuid())
  name      String
  kind      String  @default("EXPENSE") // EXPENSE | INCOME
  icon      String  @default("Circle")
  color     String  @default("#8a8a84")
  sortOrder Int     @default(0)

  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryTree")

  transactions Transaction[]
  budgets      Budget[]
  mccRules     MccRule[]
  keywordRules KeywordRule[]
  recurring    RecurringPayment[]

  @@index([kind, parentId, sortOrder])
}

model MccRule {
  id         String   @id @default(cuid())
  mcc        Int      @unique
  label      String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model KeywordRule {
  id         String   @id @default(cuid())
  pattern    String // lowercase підрядок опису
  priority   Int      @default(0)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([priority])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String // EXPENSE | INCOME | TRANSFER
  amount      Int // > 0, у валюті accountId
  toAmount    Int? // у валюті toAccountId, для крос-валютних переказів
  currency    String   @default("UAH")
  date        DateTime
  note        String?
  tags        String   @default("") // CSV
  mcc         Int?
  source      String   @default("MANUAL") // MANUAL | MONOBANK | API
  externalId  String?  @unique
  balanceAfter Int?

  accountId   String
  account     Account  @relation("TxAccount", fields: [accountId], references: [id], onDelete: Cascade)

  toAccountId String?
  toAccount   Account? @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([type, date])
}

model Budget {
  id         String   @id @default(cuid())
  month      String // "YYYY-MM"
  amount     Int // у baseCurrency
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, month])
  @@index([month])
}

model RecurringPayment {
  id           String    @id @default(cuid())
  name         String
  type         String    @default("EXPENSE") // EXPENSE | INCOME
  amount       Int
  currency     String    @default("UAH")
  frequency    String    @default("MONTHLY") // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  anchorDate   DateTime
  nextDueDate  DateTime
  reminderDays Int       @default(3)
  autoPost     Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastPostedAt DateTime?
  note         String?

  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, nextDueDate])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  rate      Float // скільки quote за 1 base
  updatedAt DateTime @updatedAt

  @@unique([base, quote])
}
