# ─── Обов'язкові ──────────────────────────────────────────────────────────

# Рядок підключення до Neon PostgreSQL.
# Vercel + Neon Marketplace додає цю змінну автоматично.
# Для ручного налаштування: https://console.neon.tech → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Секрет для підпису JWT сесій. Згенеруйте свій:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-at-least-32-characters-long"

# ─── Необов'язкові ────────────────────────────────────────────────────────

# Відновлення пароля листом. Без цього ключа endpoint повертає зрозумілу
# відмову, а пароль змінюється лише через «Профіль → Зміна пароля».
# Безкоштовний тариф Resend: 3000 листів/місяць. https://resend.com
RESEND_API_KEY=""
MAIL_FROM="Finance <onboarding@resend.dev>"

# Публічний URL застосунку — використовується в листах відновлення пароля.
APP_URL="http://localhost:5173"

# Адреса, яку застосунок називає банку під час реєстрації вебхука.
# Зазвичай не потрібна: береться з домену запиту. Задавайте лише якщо
# застосунок стоїть за проксі й сам себе бачить не за публічним іменем.
# Банк мусить достукатися сюди ззовні, тож localhost не підійде.
PUBLIC_BASE_URL=""

# Порт локального API-сервера (лише для `npm run dev`).
API_PORT="8787"
